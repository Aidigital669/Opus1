# The Opus 1 by Profile — Environment Configuration Template
# Copy this file to .env.local to configure real external integrations.

# Base URL for canonical tags, OG images, and absolute routing
NEXT_PUBLIC_SITE_URL=https://theopus1.profile.net.in

# Sales Desk Notification Recipient
NOTIFICATION_EMAIL=info@profile.net.in

# --- OPTION A: CRM / Webhook Integration ---
# Provide an HTTPS Webhook endpoint (e.g. Zapier, Make, HubSpot, Slack, Salesforce)
# When set, all verified enquiries are dispatched via POST with JSON payload.
CRM_WEBHOOK_URL=

# --- OPTION B: Resend Email API ---
# Provide your Resend API Key (https://resend.com) to dispatch real email notifications.
RESEND_API_KEY=

# --- OPTION C: Database Storage (Optional) ---
# Connection string for storing leads in PostgreSQL, MySQL, or MongoDB
DATABASE_URL=
